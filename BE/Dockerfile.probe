FROM python:3.12-slim
RUN pip install --no-cache-dir datasets
CMD ["python3", "-c", "\nimport datasets; ds = datasets.load_dataset('tmquan/sapnhap-bando-vn', 'committees', trust_remote_code=True)['train']; row = ds[0]; print('Columns:', list(row.keys())); print('Row sample:'); [print(k, '=', repr(v)[:100]) for k, v in row.items()]\n"]
